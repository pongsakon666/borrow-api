# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ══════════════════════════════════════════════════════════════════════
# LITE MODE — รันได้ทันทีโดยไม่ต้องมี Docker (SQLite + memory cache + ปิด MQ)
# เหมาะกับ dev / ทดสอบ E2E ช่วงแรก
#   DB_DRIVER=sqlite  CACHE_DRIVER=memory  MESSAGING_ENABLED=false
# พอขึ้น Docker แล้ว สลับเป็น postgres / redis / true (ค่าด้านล่างเตรียมไว้ครบ)
# ══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
DB_DRIVER=sqlite
SQLITE_PATH=.data/dev.sqlite
# ใช้เมื่อ DB_DRIVER=postgres (ตรงกับ docker-compose.local.yml)
DATABASE_URL=postgresql://rentborrow:rentborrow@localhost:5432/rentborrow
# ห้ามเปิด synchronize ใน prod — ใช้ migration เท่านั้น (sqlite sync ให้อัตโนมัติอยู่แล้ว)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Cache ─────────────────────────────────────────────────────────────
CACHE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Messaging ─────────────────────────────────────────────────────────
MESSAGING_ENABLED=false
RABBITMQ_URL=amqp://rentborrow:rentborrow@localhost:5672
RABBITMQ_QUEUE=api_queue

# ── Kafka (optional — ยังไม่ใช้ในเฟสแรก ดู README §8.1) ─────────────────
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=rent-borrow-api
# KAFKA_GROUP_ID=api

# ── Rate limit ────────────────────────────────────────────────────────
THROTTLE_TTL=60000
# dev/E2E ตั้งสูง (เช่น 1000) เพราะ Robot เปิดหลายหน้าต่อนาที · prod 100
THROTTLE_LIMIT=100
# จำนวนครั้งที่ login ได้ต่อนาที — dev/E2E ตั้งสูงเพราะรันเทสต์ซ้ำ · prod ควรเหลือ 5-10
AUTH_THROTTLE_LIMIT=100
